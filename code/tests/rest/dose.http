
@baseUrl = http://localhost:5200/api

### create a dose
# @name createDose
POST {{baseUrl}}/dose
Content-Type: application/json
X-Api-Key: apikey

{
    "takenAt": "2025-04-18T07:23:29.049Z",
    "medicationName": "Semaglutide",
    "doseAmountMg": 1.0,
    "notes": "first dose of the week"
}


### get the created dose

@locationHeader = {{createDose.response.headers.Location}}

### {{locationHeader}}

GET {{locationHeader}}
X-Api-Key: apikey


### update the notes on the created dose

PUT {{locationHeader}}
Content-Type: application/json
X-Api-Key: apikey

{
    "notes": "added this note later"
}

### get all doses for user

GET {{baseUrl}}/doses
X-Api-Key: apikey



### delete the created dose

DELETE {{locationHeader}}
X-Api-Key: apikey
