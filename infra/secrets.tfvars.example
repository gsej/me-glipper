# Template for a per-environment secrets file (e.g. m900-secrets.tfvars).
# Copy to <env>-secrets.tfvars (gitignored) and fill in.
# Keep the real values in your password manager, not here.

# Proxmox root@pam web-UI login password (needed to set the keyctl feature flag).
proxmox_password = "change-me"

# The container's OWN root account password (console/fallback login).
container_root_password = "change-me"
